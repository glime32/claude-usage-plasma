#!/usr/bin/python3 -IS
# claude-usage : usage Claude (session 5 h + semaine) pour le widget Plasma,
# et notifications PC + téléphone quand une limite est réinitialisée.
#
# Aucun démon : c'est le widget qui lance ce script de temps en temps
# (10 à 30 min selon l'activité, ~50 ms de CPU). Entre deux, rien ne tourne.
#
#   claude-usage            -> une ligne JSON (lue par le widget)
#   claude-usage --status   -> résumé lisible
#   claude-usage --test     -> notification de test sur le PC et le téléphone
import fcntl
import json
import os
import sys
import time

HOME = os.path.expanduser("~")
CRED = os.path.join(HOME, ".claude", ".credentials.json")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or HOME + "/.config", "claude-usage", "config.json")
SDIR = os.path.join(os.environ.get("XDG_STATE_HOME") or HOME + "/.local/state", "claude-usage")
STATE = os.path.join(SDIR, "state.json")

USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"  # celui de Claude Code
UA = "claude-usage-widget/1.0"
NTFY_MAX_DELAY = 3 * 86400 - 900  # ntfy.sh programme au plus 3 jours à l'avance
MIN_GAP = 120  # s : au plus un appel à l'API toutes les 2 min (redémarrages de plasmashell,
               # clics répétés) ; en deçà, on renvoie le résultat du dernier appel.
RATE_GAP = 300  # s : après un refus « trop de requêtes » (HTTP 429), 5 min sans rappeler l'API.

WIN = {
    "five_hour": ("Claude : session réinitialisée", "Ta limite de session (5 h) est revenue à 0 %"),
    "seven_day": ("Claude : semaine réinitialisée", "Ta limite hebdomadaire est revenue à 0 %"),
}


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f, separators=(",", ":"), ensure_ascii=False)
    os.replace(tmp, path)


def http(url, data=None, headers=None, timeout=15):
    import urllib.error
    import urllib.request

    h = {"User-Agent": UA, **(headers or {})}
    if data is not None:
        data = json.dumps(data).encode()
        h["Content-Type"] = "application/json"
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=data, headers=h), timeout=timeout) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()


def ts(iso):
    """ISO 8601 -> epoch arrondi à la minute (l'API renvoie des microsecondes qui varient)."""
    if not iso:
        return None
    from datetime import datetime

    return round(datetime.fromisoformat(iso).timestamp() / 60) * 60


def hm(t):
    return time.strftime("%H:%M", time.localtime(t))


# --- Jeton : on lit celui de Claude Code ; s'il a expiré (ex. la nuit), on le renouvelle
# exactement comme le ferait une 2e fenêtre de Claude Code, puis on le réécrit.
def token():
    o = load(CRED, {}).get("claudeAiOauth") or {}
    if not o.get("accessToken"):
        raise RuntimeError("pas connecté : lance `claude` une fois")
    if o.get("expiresAt", 0) > time.time() * 1000 + 60_000:
        return o["accessToken"]
    os.makedirs(SDIR, exist_ok=True)
    with open(os.path.join(SDIR, "refresh.lock"), "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        o = json.loads(open(CRED).read())["claudeAiOauth"]
        if o.get("expiresAt", 0) > time.time() * 1000 + 60_000:
            return o["accessToken"]  # renouvelé entre-temps par Claude Code
        used = o["refreshToken"]
        st, body = http(TOKEN_URL, {
            "grant_type": "refresh_token",
            "refresh_token": used,
            "client_id": CLIENT_ID,
            "scope": " ".join(o.get("scopes") or []),
        }, timeout=30)
        if st != 200:
            raise RuntimeError(f"jeton refusé ({st}) : lance `claude` une fois")
        d = json.loads(body)
        now = time.time() * 1000
        cred = json.loads(open(CRED).read())  # relu juste avant d'écrire
        o = cred["claudeAiOauth"]
        if o.get("refreshToken") != used:
            return d["access_token"]  # Claude Code a écrit un jeton plus récent : on n'y touche pas
        o["accessToken"] = d["access_token"]
        o["refreshToken"] = d.get("refresh_token") or used
        o["expiresAt"] = int(now + d["expires_in"] * 1000)
        if d.get("refresh_token_expires_in"):
            o["refreshTokenExpiresAt"] = int(now + d["refresh_token_expires_in"] * 1000)
        if d.get("scope"):
            o["scopes"] = d["scope"].split()
        save(CRED, cred)
        return o["accessToken"]


class RateLimited(RuntimeError):
    pass


def fetch():
    st, body = http(USAGE_URL, headers={
        "Authorization": "Bearer " + token(),
        "anthropic-beta": "oauth-2025-04-20",
        "Accept": "application/json",
    })
    if st == 429:
        raise RateLimited("trop de requêtes, nouvel essai plus tard")
    if st != 200:
        raise RuntimeError(f"API usage : HTTP {st}")
    return json.loads(body)


def desktop(title, body):
    import subprocess

    try:
        subprocess.run(["notify-send", "-a", "Claude", "-i", "chronometer", title, body],
                       timeout=5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def phone(cfg, title, body, at=None):
    """Push ntfy. Avec `at`, c'est le serveur ntfy qui l'envoie à l'heure exacte,
    donc ça arrive même si le PC est éteint à ce moment-là."""
    topic = cfg.get("ntfy_topic")
    if not topic:
        return False
    msg = {"topic": topic, "title": title, "message": body,
           "tags": ["arrows_counterclockwise"], "click": "https://claude.ai"}
    if at:
        msg["delay"] = str(int(at))
    try:
        st, _ = http(cfg.get("ntfy_server") or "https://ntfy.sh", msg, timeout=10)
        return st == 200
    except Exception:
        return False


def run(cfg):
    now = time.time()
    st = load(STATE, {})
    last = st.setdefault("last", {})
    notified = st.setdefault("notified", {})
    pushed = st.setdefault("pushed", {})

    # 1) Fenêtres arrivées à échéance -> notif PC (marche même sans réseau).
    for k, (title, body) in WIN.items():
        p = last.get(k) or {}
        r = p.get("r")
        if r and now >= r:
            if notified.get(k) != r:
                notified[k] = r
                if p.get("u", 0) > 0:
                    msg = f"{body} à {hm(r)}."
                    if cfg.get("desktop", True):
                        desktop(title, msg)
                    if pushed.get(k) != r and phone(cfg, title, msg):
                        pushed[k] = r  # pas pu être programmée avant : envoyée maintenant
            last[k] = {"u": 0, "r": None}

    # 2) Usage actuel + 3) notif téléphone programmée à l'heure de réinitialisation.
    err = ""
    if now - st.get("tried", 0) < (RATE_GAP if st.get("rl") else MIN_GAP):
        err = st.get("err", "")  # appel trop récent : dernier résultat, sans rappeler l'API
    else:
        st["tried"] = int(now)
        st["rl"] = False
        try:
            data = fetch()
            for k, (title, body) in WIN.items():
                w = data.get(k) or {}
                u = float(w.get("utilization") or 0)
                r = ts(w.get("resets_at"))
                if r and r <= now:
                    u, r = 0.0, None
                last[k] = {"u": u, "r": r}
                if r and u > 0 and pushed.get(k) != r and r - now <= NTFY_MAX_DELAY:
                    if phone(cfg, title, f"{body} à {hm(r)}.", at=r):
                        pushed[k] = r
            st["t"] = int(now)
        except RateLimited as e:
            st["rl"] = True
            err = str(e)
        except Exception as e:
            err = (str(e) or type(e).__name__)[:120]
        st["err"] = err
    save(STATE, st)

    f, s = last.get("five_hour") or {}, last.get("seven_day") or {}
    return {
        "ok": not err, "e": err, "rl": bool(st.get("rl")), "t": st.get("t", 0),
        "s": round(f["u"]) if "u" in f else -1, "sr": f.get("r") or 0,
        "w": round(s["u"]) if "u" in s else -1, "wr": s.get("r") or 0,
    }


def main():
    args = sys.argv[1:]
    cfg = load(CONF, {})
    if "--test" in args:
        desktop("Claude : test", "Les notifications PC marchent.")
        ok = phone(cfg, "Claude : test", "Les notifications téléphone marchent.")
        print("PC : envoyé | téléphone :", "envoyé" if ok else "échec (topic ntfy manquant ou pas de réseau)")
        return
    os.makedirs(SDIR, exist_ok=True)
    with open(os.path.join(SDIR, "run.lock"), "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)  # un seul lancement à la fois
        out = run(cfg)
    if "--status" in args:
        jours = ["lun.", "mar.", "mer.", "jeu.", "ven.", "sam.", "dim."]

        def line(name, u, r, jour):
            when = (jours[time.localtime(r).tm_wday] + " " if jour else "") + time.strftime("%d/%m %H:%M" if jour else "%H:%M", time.localtime(r)) if r else ""
            return f"{name} : {u} %" + (f"  (réinit. {when})" if r else "")
        print(line("Session ", out["s"], out["sr"], False))
        print(line("Semaine ", out["w"], out["wr"], True))
        if out["e"]:
            print("Erreur  :", out["e"])
    else:
        print(json.dumps(out, separators=(",", ":")))


if __name__ == "__main__":
    main()
